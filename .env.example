# Copie ce fichier vers .env et remplis-le. .env est gitignore.

# Application principale
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Applications supplementaires (optionnel).
# Chacune dispose de son propre quota de 1200 req/h : le client bascule
# automatiquement sur celle dont le quota se libere le plus tot.
# Numerote a la suite : _2, _3, ...
# FT_CLIENT_ID_2=
# FT_CLIENT_SECRET_2=

# Sel de pseudonymisation. Genere-le une fois avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT : identique sur toutes tes machines, sinon les uid_hash
# divergent et les jeux de donnees ne sont plus fusionnables.
HASH_SALT=
